# FastAPI Environment Configuration - Independent Backend
DEBUG=True
PORT=8001
HOST=0.0.0.0

# CORS - Frontend URLs (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000,https://smart-plant-watering-system.vercel.app

# Database Configuration
# Local Development: SQLite
DATABASE_URL=sqlite:///./fastapi.db

# Production (Render): Change to PostgreSQL
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
