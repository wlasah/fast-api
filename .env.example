# FastAPI Environment Configuration
DEBUG=True
PORT=8001
HOST=0.0.0.0

# CORS - Frontend URLs (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.1.10:3000,https://smart-plant-watering-system.vercel.app

# Database (optional - for future use)
DATABASE_URL=sqlite:///./fastapi.db

# JWT Configuration
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256

# Django Backend Integration (for syncing data)
DJANGO_API_URL=http://localhost:8000/api
DJANGO_API_URL_PRODUCTION=https://smart-plant-backend-39w7.onrender.com/api
